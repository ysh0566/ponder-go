package main

import (
	"context"
	_ "embed"
	"math/big"
	"strconv"

	"github.com/ysh0566/ponder-go/config"
	"github.com/ysh0566/ponder-go/logging"
	"github.com/ysh0566/ponder-go/runtime"
	"github.com/ysh0566/ponder-go/store"
)

//go:embed abi.json
var tokenABI []byte

func project(network networkConfig, _ *logging.Logger) (config.Config, map[string]runtime.Handler) {
	contract := network.contract("ERC721", tokenABI)
	return config.Config{Contracts: []config.Contract{contract}}, map[string]runtime.Handler{"ERC721:Transfer": transfer}
}

func transfer(ctx context.Context, c *runtime.Context) error {
	args := c.Event.Args.(map[string]any)
	from, to := args["from"].(string), args["to"].(string)
	id := args["id"].(*big.Int).String()
	for _, owner := range []string{from, to} {
		if err := c.DB.Write(ctx, "account", store.Row{"address": owner}, store.Upsert); err != nil {
			return err
		}
	}
	if err := c.DB.Write(ctx, "token", store.Row{"id": id, "owner": to}, store.Upsert); err != nil {
		return err
	}
	ts, err := strconv.ParseInt(c.Event.Block.Timestamp, 0, 64)
	if err != nil {
		return err
	}
	return c.DB.Write(ctx, "transfer_event", store.Row{"id": c.Event.ID, "from": from, "to": to, "token": id, "timestamp": ts}, store.Insert)
}
