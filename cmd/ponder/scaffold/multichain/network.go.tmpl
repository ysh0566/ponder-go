package main

import (
	"encoding/json"
	"fmt"
	"os"

	"github.com/ysh0566/ponder-go/schema"
)

const projectOrdering = schema.Isolated

func projectNetworks(raw []byte) ([]networkConfig, error) {
	var networks []networkConfig
	if err := json.Unmarshal(raw, &networks); err != nil {
		return nil, err
	}
	for i := range networks {
		networks[i].wsURL = os.Getenv(fmt.Sprintf("PONDER_WS_URL_%d", networks[i].ID))
	}
	return networks, nil
}
