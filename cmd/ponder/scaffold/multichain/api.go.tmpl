package main

import (
	"net/http"

	"github.com/ysh0566/ponder-go/graphql"
	"github.com/ysh0566/ponder-go/query"
)

func configureAPI(server *query.Server) error {
	db := server.Store
	handler, err := graphql.New(db, graphql.Options{})
	if err != nil {
		return err
	}
	mux := http.NewServeMux()
	mux.Handle("/{$}", handler)
	mux.Handle("/graphql", handler)
	server.API = mux
	return nil
}
