package main

import (
	"net/http"

	"github.com/ysh0566/ponder-go/graphql"
	"github.com/ysh0566/ponder-go/query"
)

func configureAPI(server *query.Server) error {
	db := server.Store
	handler, err := graphql.New(db, graphql.Options{Relations: []graphql.Relation{
		{Table: "account", Name: "transferFromEvents", Target: "transfer_event", Many: true, RelationName: "from_account"},
		{Table: "account", Name: "transferToEvents", Target: "transfer_event", Many: true, RelationName: "to_account"},
		{Table: "transfer_event", Name: "fromAccount", Target: "account", Fields: []string{"from"}, References: []string{"address"}, RelationName: "from_account"},
		{Table: "transfer_event", Name: "toAccount", Target: "account", Fields: []string{"to"}, References: []string{"address"}, RelationName: "to_account"},
	}})
	if err != nil {
		return err
	}
	mux := http.NewServeMux()
	mux.Handle("/{$}", handler)
	mux.Handle("/graphql", handler)
	server.API = mux
	return nil
}
