[
  {
    "id": "e53020cec4f7f158cc7c",
    "line": 9,
    "full_name": "buildLogFactory throws if provided parameter not found in inputs",
    "source_file": "packages/core/src/build/factory.test.ts",
    "source_sha256": "e3111d8ca8e32ceddcfd06025777fbbf35867632dffb4db09d5f06a3f635beb5",
    "assertions": [
      {
        "input": {
          "operation": "buildLogFactory",
          "args": [
            {
              "address": "0xa",
              "event": {
                "name": "LlamaInstanceCreated",
                "type": "event",
                "inputs": [
                  {
                    "type": "address",
                    "name": "deployer",
                    "indexed": true
                  },
                  {
                    "type": "string",
                    "name": "name",
                    "indexed": true
                  },
                  {
                    "type": "address",
                    "name": "llamaCore"
                  },
                  {
                    "type": "address",
                    "name": "llamaExecutor"
                  },
                  {
                    "type": "address",
                    "name": "llamaPolicy"
                  },
                  {
                    "type": "uint256",
                    "name": "chainId"
                  }
                ]
              },
              "parameter": "fakeParameter",
              "chainId": 1,
              "sourceId": "Llama"
            }
          ]
        },
        "matcher": "toThrowError",
        "expected": "Factory event parameter not found in factory event signature. Got 'fakeParameter', expected one of ['deployer', 'name', 'llamaCore', 'llamaExecutor', 'llamaPolicy', 'chainId']."
      }
    ]
  },
